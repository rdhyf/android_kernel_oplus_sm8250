#include <dt-bindings/thermal/thermal.h>

&mdss_mdp {
	#cooling-cells = <2>;
};

&thermal_zones {
//remove low battery isoalte gold CPUs policy
//	soc {
//		cooling-maps {
//			soc_cpu4 {
//				trip = <&soc_trip>;
//				cooling-device = <&cpu4_isolate 1 1>;
//			};
//
