				temperature = <75000>;
				hysteresis = <5000>;
				type = "passive";
			};
		};

		cooling-maps {
			cpufreq_cdev {
				trip = <&cpufreq_14_config>;
				cooling-device = <&cpu7_notify 1 1>;
			};
		};
	};

	cpu-1-5-step {
		trips {
			cpufreq_15_config: cpufreq-15-config {
				temperature = <75000>;
				hysteresis = <5000>;
				type = "passive";
			};
		};

		cooling-maps {
			cpufreq_cdev {
				trip = <&cpufreq_15_config>;
				cooling-device = <&cpu7_notify 1 1>;
			};
		};
	};

	cpu-1-6-step {
		trips {
			cpufreq_16_config: cpufreq-16-config {
				temperature = <75000>;
				hysteresis = <5000>;
				type = "passive";
			};
		};

		cooling-maps {
			cpufreq_cdev {
				trip = <&cpufreq_16_config>;
				cooling-device = <&cpu7_notify 1 1>;
			};
		};
	};

	cpu-1-7-step {
		trips {
			cpufreq_17_config: cpufreq-17-config {
